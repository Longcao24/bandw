{
  "name": "bandw-khkt",
  "private": true,
  "type": "module",
  "description": "Giáo trình trực quan BandW cho đội thi KHKT (Cloudflare Pages + D1).",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "wrangler pages dev public",
    "db:local": "wrangler d1 execute bandw-khkt-progress --local --file=schema.sql",
    "db:remote": "wrangler d1 execute bandw-khkt-progress --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute bandw-khkt-progress --local --file=db-migrations/progress_64kb.sql",
    "db:migrate:remote": "wrangler d1 execute bandw-khkt-progress --remote --file=db-migrations/progress_64kb.sql",
    "deploy": "wrangler pages deploy public --project-name bandw-khkt",
    "test": "node --test 'tests/*.test.mjs'",
    "videos": "cd video-src && npm install --no-audit --no-fund && node render.mjs",
    "serve": "python3 -m http.server 8788 -d public"
  },
  "devDependencies": { "wrangler": "^4.0.0", "playwright-core": "^1.50.0" }
}
